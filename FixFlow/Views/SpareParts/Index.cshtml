@model IReadOnlyList<SparePartListViewModel>

@{
    ViewData["Title"] = "Spare Parts";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-4">
    <h1 class="mb-0">Spare Parts</h1>
    <a asp-action="Create" class="btn btn-primary">Add Spare Part</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info" role="status">No spare parts have been added yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Part Name</th>
                    <th>SKU</th>
                    <th class="text-end">Unit Price</th>
                    <th class="text-end">In Stock</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var part in Model)
                {
                    <tr>
                        <td>@part.Name</td>
                        <td>@part.SKU</td>
                        <td class="text-end">@part.UnitPrice.ToString("N2")</td>
                        <td class="text-end">
                            @if (part.QuantityInStock == 0)
                            {
                                <span class="badge bg-warning text-dark">Out of stock</span>
                            }
                            else
                            {
                                @part.QuantityInStock
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                                <a asp-action="Details" asp-route-id="@part.Id"
                                   class="btn btn-sm btn-outline-primary">Details</a>
                                <a asp-action="Edit" asp-route-id="@part.Id"
                                   class="btn btn-sm btn-outline-secondary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@part.Id"
                                   class="btn btn-sm btn-outline-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
