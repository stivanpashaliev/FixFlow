@model CustomerDetailsViewModel

@{
    ViewData["Title"] = "Delete Customer";
}

<h1 class="mb-4">Delete Customer</h1>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<p>Customer: <strong>@Model.FullName</strong></p>
<p>Phone: @Model.PhoneNumber</p>
<p>Repair requests: @Model.RepairRequestsCount</p>

@if (Model.RepairRequestsCount > 0)
{
    <div class="alert alert-warning" role="alert">
        This customer has repair requests and cannot be deleted.
    </div>
    <a asp-action="Details" asp-route-id="@Model.Id"
       class="btn btn-secondary">Back to Details</a>
}
else
{
    <div class="alert alert-warning" role="alert">
        Are you sure you want to permanently delete this customer?
    </div>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
        <a asp-action="Details" asp-route-id="@Model.Id"
           class="btn btn-secondary">Cancel</a>
    </form>
}