@model TechnicianDetailsViewModel

@{
    ViewData["Title"] = "Delete Technician";
}

<h1 class="mb-4">Delete Technician</h1>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<p>Technician: <strong>@Model.FullName</strong></p>
<p>Specialization: @(Model.Specialization ?? "Not specified")</p>
<p>Repair requests: @Model.RepairRequestsCount</p>

@if (Model.RepairRequestsCount > 0)
{
    <div class="alert alert-warning" role="alert">
        This technician has repair requests and cannot be deleted.
        You can mark the technician as inactive instead.
    </div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit Technician</a>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Back to Details</a>
}
else
{
    <div class="alert alert-warning" role="alert">
        Are you sure you want to permanently delete this technician?
    </div>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
    </form>
}