@model IReadOnlyList<TechnicianListViewModel>

@{
    ViewData["Title"] = "Technicians";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Technicians</h1>
    <a asp-action="Create" class="btn btn-primary">Add Technician</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info" role="status">No technicians have been added yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Full Name</th>
                    <th>Specialization</th>
                    <th>Status</th>
                    <th>Repairs</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var technician in Model)
                {
                    <tr>
                        <td>@technician.FullName</td>
                        <td>@(technician.Specialization ?? "Not specified")</td>
                        <td>
                            @if (technician.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>@technician.RepairRequestsCount</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@technician.Id"
                               class="btn btn-sm btn-outline-primary">Details</a>
                            <a asp-action="Edit" asp-route-id="@technician.Id"
                               class="btn btn-sm btn-outline-secondary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@technician.Id"
                               class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}