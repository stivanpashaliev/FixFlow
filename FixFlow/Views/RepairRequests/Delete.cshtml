@model RepairRequestDetailsViewModel

@{
    ViewData["Title"] = "Delete Repair Request";
}

<h1 class="mb-4">Delete Repair Request #@Model.Id</h1>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<p>Device: <strong>@Model.DeviceName</strong></p>
<p>Customer: @Model.CustomerName</p>
<p>Status: @Model.Status</p>
<p>Parts used (records): @Model.RepairPartsCount</p>

@if (!Model.CanDelete)
{
    <div class="alert alert-warning" role="alert">Only new repairs can be deleted.</div>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Back to Details</a>
}
else if (Model.RepairPartsCount > 0)
{
    <div class="alert alert-warning" role="alert">
        This repair uses spare parts and cannot be deleted. Inventory cannot be
        restored automatically at this stage.
    </div>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
        Back to Details
    </a>
}
else
{
    <div class="alert alert-warning" role="alert">
        Are you sure you want to permanently delete this repair request?
        Any linked status-history records will be deleted as well.
    </div>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
    </form>
}
