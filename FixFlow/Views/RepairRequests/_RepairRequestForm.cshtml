@model RepairRequestFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="mb-3">
    <label asp-for="CustomerId" class="form-label"></label>
    <select asp-for="CustomerId" asp-items="Model.Customers" class="form-select">
        <option value="0">-- Select a customer --</option>
    </select>
    <span asp-validation-for="CustomerId" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="TechnicianId" class="form-label"></label>
    <select asp-for="TechnicianId" asp-items="Model.Technicians" class="form-select">
        <option value="">-- Unassigned --</option>
    </select>
    <span asp-validation-for="TechnicianId" class="text-danger"></span>
    <div class="form-text">Only active technicians are available for new assignments.</div>
</div>

<div class="mb-3">
    <label asp-for="DeviceName" class="form-label"></label>
    <input asp-for="DeviceName" class="form-control" maxlength="150" />
    <span asp-validation-for="DeviceName" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="ProblemDescription" class="form-label"></label>
    <textarea asp-for="ProblemDescription" class="form-control" rows="4" maxlength="1000"></textarea>
    <span asp-validation-for="ProblemDescription" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Diagnosis" class="form-label"></label>
    <textarea asp-for="Diagnosis" class="form-control" rows="3" maxlength="1000"></textarea>
    <span asp-validation-for="Diagnosis" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="LaborCost" class="form-label"></label>
    <input asp-for="LaborCost" type="number" min="0" step="0.01" class="form-control" />
    <span asp-validation-for="LaborCost" class="text-danger"></span>
</div>

<div class="mb-4">
    <label class="form-label">Status</label>
    <div class="form-control-plaintext">@Model.Status</div>
    <div class="form-text">
        Status changes are not part of the standard edit form.
        The repair workflow will manage status history separately.
    </div>
</div>
